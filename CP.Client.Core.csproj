<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!--NuGet Properties-->
    <PackageId>CP.Client.Core</PackageId>
    <Version>1.1.0.47</Version>
    <Authors>Ben</Authors>
    <Company>Personal</Company>
    <Description>
      Core client-side library for offline intent capture and
      read-only Knowledge caching for the CP ecosystem.
    </Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!--/NuGet Properties-->
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Diagnostics\" />
    <Folder Include="Internal\" />
    <Folder Include="Knowledge\" />
    <Folder Include="Serialization\" />
    <Folder Include="Storage\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CP.Shared.Primitives" Version="1.1.0.47" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Scripts\CompleteCleanAndRebuild.ps1">
      <Link>_Scripts\CompleteCleanAndRebuild.ps1</Link>
    </Content>
    <Content Include="..\..\..\Scripts\FilesAndFolders.ps1">
      <Link>_Scripts\FilesAndFolders.ps1</Link>
    </Content>
    <Content Include="..\..\..\Scripts\publish-local-nuget.ps1">
      <Link>_Scripts\publish-local-nuget.ps1</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="appicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="appicon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="appicon.xcf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="appicon_background.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
</Project>